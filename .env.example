# Copie para .env e preencha com valores reais.
# NUNCA versionar o arquivo .env.

PORT=8081

# Obrigatória: mínimo 24 caracteres aleatórios. Não use valores fracos (dev-localhost, changeme, etc.).
API_KEY=replace-with-a-long-random-api-key

# Microsoft Entra App Registration
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=replace-with-your-client-secret
MS_TENANT=consumers
MS_REDIRECT_URI=http://localhost:8081/v1/oauth/microsoft/callback

# Opcional — default já cobre o fluxo de envio + perfil
# MS_SCOPES=https://graph.microsoft.com/Mail.Send https://graph.microsoft.com/User.Read offline_access openid profile

# Arquivo local com tokens OAuth (não versionar)
TOKEN_STORE_PATH=./data/tokens.json
